# Environment files. .env.example is the one that may be committed.
.env*
!.env.example

# Editor and backup leftovers
*.bak*
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.vscode/
.idea/
*.swp
*.swo

# Keys and credentials
*.pem
*.key
id_rsa*
id_ed25519*
auth*.json
*credentials*
*.secret
secrets/

# Session exports
*session-export*
*session_export*

# Logs
*.log

# Common caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.venv/
__pycache__/
*.pyc
.tox/
.coverage
htmlcov/

# Secret scan temp
.gitleaks-report.json

# Local topgrade flags (never Apple ID passwords)
**/topgrade.env
!**/topgrade.env.example

# Per-machine private briefing. Commit the examples only.
machine.md
**/machine.md
machine-*.md
!machine.md.example

# Private Pass maps. Examples are committed.
scripts/pass-ssh-key-map.local
scripts/pass-env-map.local
**/pass-ssh-key-map.local
**/pass-env-map.local
scripts/smb-hosts.local
**/smb-hosts.local
scripts/himalaya-accounts.local
**/himalaya-accounts.local
scripts/hue.local
**/hue.local

# Generated Mail.app profiles embed IMAP passwords.
*.mobileconfig

# Optional private AI notes. CLAUDE.md is a tracked symlink to AGENTS.md.
AGENTS.local.md
CLAUDE.local.md
GEMINI.md
OPENCODE.md
CODEX.md
COPILOT.md

# Public repository. HANDOFF.md stays untracked.
# Write the handoff in agent-platform at handoffs/<repo>.md.
# CHANGELOG.private.md holds notes that must not be published.
HANDOFF.md
CHANGELOG.private.md
