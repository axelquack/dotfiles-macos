# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Machine-specific host entries (populated from Proton Pass via chezmoi, not tracked in repo)
Include ~/.ssh/config.local
{{- /*
  Optional private host blocks that are not in the Pass note (for example a
  VM alias that needs its own User and IdentityFile). They come verbatim from
  the local chezmoi data key `ssh_private_hosts` in
  ~/.config/chezmoi/chezmoi.toml, which is never committed. Without the key,
  nothing is rendered here. See docs/ssh-hosts.md.
*/}}
{{- with get . "ssh_private_hosts" }}

{{ . }}
{{- end }}

Host github.com
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
