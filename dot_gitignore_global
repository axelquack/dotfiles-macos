# Stack: Python (pyenv + uv), Ruby (rbenv), Node.js (fnm), Rust (rustup), Deno, Docker (OrbStack), macOS, Zed

# --- Project Version Files ---
# Commit these into your repos — they ensure correct language versions across environments.
# Uncomment only if you have a specific reason NOT to track them.
# .python-version
# .ruby-version
# .node-version
# .nvmrc

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
*.egg
.ipynb_checkpoints/

