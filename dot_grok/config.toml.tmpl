[cli]
installer = "internal"
auto_update = true

[ui]
max_thoughts_width = 120
fork_secondary_model = "grok-build"
yolo = false
compact_mode = false
permission_mode = "always-approve"
theme = "tokyonight"

[session]
# Compact at 50% of the 500k window (~250k) instead of the 80% default (~400k).
# Failing turns were re-sending ~260k uncached tokens on every 502 retry.
auto_compact_threshold_percent = 50

{{- with get . "grok_agentzero_mcp_url" }}
[mcp_servers.agentzero-olares]
url = "{{ . }}"
description = "Agent Zero Researcher on Olares (local 35B GPU pod) — not haumea; enable when pod is up"
enabled = false
{{- end }}

[mcp_servers.raindroptest]
url = "https://api.raindrop.io/rest/v2/ai/mcp"
description = "Raindrop.io bookmarks, collections and highlights (cloud)"

[mcp_servers.raindroptest.headers]
Authorization = "Bearer ${RAINDROP_MCP_TOKEN}"

{{- with get . "grok_homeassistant_mcp_url" }}
[mcp_servers.homeassistant]
url = "{{ . }}"
description = "Home Assistant (LAN) — lights, sensors, scenes, automations"

[mcp_servers.homeassistant.headers]
Authorization = "Bearer ${HOMEASSISTANT_MCP_TOKEN}"
{{- end }}

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp/"
description = "Context7 — up-to-date library documentation (cloud)"

[mcp_servers.searxng-haumea]
url = "http://localhost:8001/mcp"
description = "SearXNG on haumea (hermes-stack / OrbStack) — private web search gateway"

[mcp_servers.searxng-haumea.headers]
Authorization = "Bearer ${MCP_SEARXNG_AUTH_TOKEN}"

[mcp_servers.playwright-haumea]
url = "http://localhost:8002/mcp"
description = "Playwright on haumea (hermes-stack / OrbStack) — headless browser automation"

[mcp_servers.playwright-haumea.headers]
Authorization = "Bearer ${MCP_PLAYWRIGHT_AUTH_TOKEN}"

[mcp_servers.penpot-haumea]
url = "http://localhost:9001/mcp/stream?userToken=${PENPOT_MCP_TOKEN}"
description = "Penpot on haumea (hermes-stack) — decks/presentations via execute_code"

[mcp_servers.zapier]
url = "https://mcp.zapier.com/api/mcp/sse"
enabled = true
description = "Zapier MCP — X (@axelquack) / Facebook (needs a Page) and other Zapier apps"

[mcp_servers.zapier.headers]
Authorization = "Bearer ${ZAPIER_MCP_TOKEN}"
Accept = "application/json, text/event-stream"

[marketplace]
official_marketplace_auto_installed = true
default_skills_installs_purged = true

[[marketplace.sources]]
name = "xAI Official"
git = "https://github.com/xai-org/plugin-marketplace.git"
