# ~/.grok/config.toml — Grok Build TUI policy (chezmoi template)
# Tokens live in ~/.grok/.env (local only). LAN MCP URLs come from local
# chezmoi.toml data keys grok_homeassistant_mcp_url / grok_agentzero_mcp_url.
# Auth is grok login (OAuth), not XAI_API_KEY.

[models]
default = "grok-4.6"
web_search = "grok-4.5"
default_reasoning_effort = "high"

[model_providers.opencode-zen]
base_url = "https://opencode.ai/zen/v1"
env_key = "OPENCODE_ZEN_API_KEY"
name = "OpenCode Zen"

