{{- /*
  ~/.grok/config.toml — Grok Build TUI policy (chezmoi template)
  Tokens live in ~/.grok/.env (local only). The optional Home Assistant
  MCP URL comes from the local chezmoi.toml data key grok_homeassistant_mcp_url.
  Auth is grok login (OAuth), not XAI_API_KEY.
  Do not emit TOML # comments: Grok TUI rewrites this file and strips them,
  which makes chezmoi think the dest drifted. [privacy] is TUI-local — re-injected
  from the destination at apply time (see end of this file).
  2026-11-15: models.default is grok-4.7 and default_reasoning_effort is medium
  (Axel: "Grok template: align to live (grok-4.7, medium, no Zapier/Zen/Cohere)
  and also drop Penpot and agentzero"). Raise effort per task when a task needs
  more depth. Zapier, OpenCode Zen, Cohere, Penpot, Agent Zero and Elgato MCP
  are not in this template. A full chezmoi apply is still withheld because
  other dest files remain on the 2026-11-14 drift list; do not apply this
  target until the owner says so.
*/ -}}
[models]
default = "grok-4.7"
web_search = "grok-4.5"
default_reasoning_effort = "medium"

[model_providers.opencode-go]
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
name = "OpenCode Go"
extra_headers = { "x-opencode-session" = "grok-build-tui" }

[model.oc-go-deepseek-v4-1-flash]
model = "deepseek-v4.1-flash"
model_provider = "opencode-go"
name = "DeepSeek V4.1 Flash (OpenCode Go)"
description = "OpenCode Go — same as Obsidian/OpenCode picker"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "chat_completions"

[model.oc-go-deepseek-v4-pro]
model = "deepseek-v4-pro"
model_provider = "opencode-go"
name = "DeepSeek V4 Pro (OpenCode Go)"
description = "OpenCode Go — same as Obsidian/OpenCode picker"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "chat_completions"

[model.oc-go-glm-5-2]
model = "glm-5.2"
model_provider = "opencode-go"
name = "GLM-5.2 (OpenCode Go)"
description = "OpenCode Go — same as Obsidian/OpenCode picker"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "chat_completions"

[model.oc-go-kimi-k2-7-code]
model = "kimi-k2.7-code"
model_provider = "opencode-go"
name = "Kimi K2.7 Code (OpenCode Go)"
description = "OpenCode Go — same as Obsidian/OpenCode picker"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "chat_completions"

[model.oc-go-kimi-k3]
model = "kimi-k3"
model_provider = "opencode-go"
name = "Kimi K3 (OpenCode Go)"
description = "OpenCode Go — same as Obsidian/OpenCode picker"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "chat_completions"

[model.oc-go-qwen3-8-max]
model = "qwen3.8-max"
model_provider = "opencode-go"
name = "Qwen 3.8 Max (OpenCode Go)"
description = "OpenCode Go — Anthropic Messages (x-api-key), same as Goose oc_go_qwen"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "messages"
env_http_headers = { "x-api-key" = "OPENCODE_GO_API_KEY" }
extra_headers = { "anthropic-version" = "2023-06-01", "x-opencode-session" = "grok-build-tui" }

[model.oc-go-qwen3-7-plus]
model = "qwen3.7-plus"
model_provider = "opencode-go"
name = "Qwen 3.7 Plus (OpenCode Go)"
description = "OpenCode Go — Anthropic Messages (x-api-key), same as Goose oc_go_qwen"
base_url = "https://opencode.ai/zen/go/v1"
env_key = "OPENCODE_GO_API_KEY"
api_backend = "messages"
env_http_headers = { "x-api-key" = "OPENCODE_GO_API_KEY" }
extra_headers = { "anthropic-version" = "2023-06-01", "x-opencode-session" = "grok-build-tui" }

[cli]
installer = "internal"
auto_update = true

[ui]
max_thoughts_width = 120
fork_secondary_model = "grok-build"
yolo = false
compact_mode = false
permission_mode = "always-approve"
theme = "tokyonight"

[session]
auto_compact_threshold_percent = 50

[mcp_servers.raindroptest]
url = "https://api.raindrop.io/rest/v2/ai/mcp"
description = "Raindrop.io bookmarks, collections and highlights (cloud)"

[mcp_servers.raindroptest.headers]
Authorization = "Bearer ${RAINDROP_MCP_TOKEN}"

{{- with get . "grok_homeassistant_mcp_url" }}
[mcp_servers.homeassistant]
url = "{{ . }}"
description = "Home Assistant (LAN) — lights, sensors, scenes, automations"

[mcp_servers.homeassistant.headers]
Authorization = "Bearer ${HOMEASSISTANT_MCP_TOKEN}"
{{- end }}

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp/"
description = "Context7 — up-to-date library documentation (cloud)"

[mcp_servers.{{ or (get $ "private_grok_search_name") "searxng-local" }}]
url = "http://localhost:8001/mcp"
description = "{{ or (get $ "private_grok_search_description") "SearXNG \u2014 private web search gateway" }}"

[mcp_servers.{{ or (get $ "private_grok_search_name") "searxng-local" }}.headers]
Authorization = "Bearer ${MCP_SEARXNG_AUTH_TOKEN}"

[mcp_servers.{{ or (get $ "private_grok_browser_name") "playwright-local" }}]
url = "http://localhost:8002/mcp"
description = "{{ or (get $ "private_grok_browser_description") "Playwright \u2014 headless browser automation" }}"

[mcp_servers.{{ or (get $ "private_grok_browser_name") "playwright-local" }}.headers]
Authorization = "Bearer ${MCP_PLAYWRIGHT_AUTH_TOKEN}"

[marketplace]
official_marketplace_auto_installed = true
default_skills_installs_purged = true

[[marketplace.sources]]
name = "xAI Official"
git = "https://github.com/xai-org/plugin-marketplace.git"
{{- /* Preserve Grok TUI [privacy] (privacy_banner_acked, etc.) — local only. */ -}}
{{- $dest := joinPath .chezmoi.homeDir ".grok" "config.toml" -}}
{{- if stat $dest -}}
{{- $raw := include $dest -}}
{{- $priv := regexFind `(?m)^\[privacy\](?:\n(?:[^[\n].*)?)*` $raw -}}
{{- if $priv }}

{{ trim $priv }}
{{- end -}}
{{- end }}
