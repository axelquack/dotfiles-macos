    { if.app-id = 'com.ubnt.wifiman', run = 'layout floating' },                                  # WiFiman iOS-on-Mac (Silicon only)
    { if.app-id = 'ui.wifiman.desktop', run = 'layout floating' },                                # WiFiman Desktop (brew cask; Intel + Silicon)
    { if.app-id = 'sh.loft.devpod', run = 'layout floating' },                                    # DevPod
    { if.app-id = 'io.raindrop.macapp', run = 'layout floating' },
    { if.app-id = 'io.raindrop.safari', run = 'layout floating' },
    { if.app-id = 'today.neil.pocket-sync', run = 'layout floating' },
    { if.app-id = 'dev.kdrag0n.MacVirt', run = 'layout floating' },
