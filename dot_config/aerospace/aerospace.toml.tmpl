[key-mapping]
    # Physical German keyboard; AeroSpace only ships qwerty/dvorak/colemak presets.
    preset = 'qwerty'

[gaps]
    inner.horizontal = 10
    inner.vertical   = 10
    outer.left       = 10
    outer.bottom     = 10
    outer.top        = 10
    outer.right      = 10

[mode.main.binding]
    # Layout
    alt-slash = 'layout tiles horizontal vertical'
    alt-comma = 'layout accordion'

    # Focus (arrows — reliable on DE keyboard)
    alt-left  = 'focus left'
    alt-down  = 'focus down'
    alt-up    = 'focus up'
    alt-right = 'focus right'

    # Move windows
    alt-shift-left  = 'move left'
    alt-shift-down  = 'move down'
    alt-shift-up    = 'move up'
    alt-shift-right = 'move right'

    # Workspaces
    alt-cmd-1 = 'workspace web'
    alt-cmd-2 = 'workspace code'
    alt-cmd-3 = 'workspace term'
    alt-cmd-4 = 'workspace comms'
    alt-cmd-5 = 'workspace docs'
    alt-cmd-6 = 'workspace media'
    alt-cmd-7 = 'workspace files'
    alt-cmd-8 = 'workspace games'
    alt-cmd-9 = 'workspace design'
    alt-cmd-0 = 'workspace vm'

    # Move focused window to workspace
    alt-shift-1 = 'move-node-to-workspace web'
    alt-shift-2 = 'move-node-to-workspace code'
    alt-shift-3 = 'move-node-to-workspace term'
    alt-shift-4 = 'move-node-to-workspace comms'
    alt-shift-5 = 'move-node-to-workspace docs'
    alt-shift-6 = 'move-node-to-workspace media'
    alt-shift-7 = 'move-node-to-workspace files'
    alt-shift-8 = 'move-node-to-workspace games'
    alt-shift-9 = 'move-node-to-workspace design'
    alt-shift-0 = 'move-node-to-workspace vm'

    # Window chrome
    alt-f       = 'layout floating tiling'
    alt-shift-f = 'macos-native-fullscreen'
    alt-shift-c = 'close'
    alt-tab     = 'workspace-back-and-forth'

    # Modes / meta
    alt-r       = 'mode resize'
    alt-shift-r = 'reload-config'
    alt-shift-q = 'exec-and-forget /usr/bin/killall AeroSpace'

[mode.resize.binding]
    h     = 'resize width -50'
    j     = 'resize height +50'
    k     = 'resize height -50'
    l     = 'resize width +50'
    left  = 'resize width -50'
    down  = 'resize height +50'
    up    = 'resize height -50'
    right = 'resize width +50'
    minus = 'resize smart -50'
    equal = 'resize smart +50'
    esc   = 'mode main'
    enter = 'mode main'
