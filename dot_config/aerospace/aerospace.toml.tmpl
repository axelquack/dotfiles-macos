    { if.app-id = 'com.blackmagic-design.switchers.softwarecontrol', run = 'layout floating' },
    { if.app-id = 'com.blackmagic-design.switchers.uninstaller', run = 'layout floating' },
    { if.app-id = 'org.prismlauncher.PrismLauncher', run = 'layout floating' },
    { if.app-id = 'com.microsoft.rdc.macos', run = 'layout floating' },
    { if.app-id = 'bobko.aerospace', run = 'layout floating' },
    { if.app-id = 'com.brettterpstra.marked2', run = 'layout floating' },                        # Marked 2

    # ========== WORKSPACE: web (1) ==========
    { if.app-id = 'com.brave.Browser', run = 'move-node-to-workspace web' },
    { if.app-id = 'com.apple.Safari', run = 'move-node-to-workspace web' },

    # ========== WORKSPACE: code (2) ==========
    # Zed often opens in macOS native fullscreen (remembers last quit state).
    # layout tiling alone cannot exit native fullscreen — force-tile script does.
    { if.app-id = 'dev.zed.Zed', run = [
        'move-node-to-workspace code',
        'exec-and-forget {{ .chezmoi.homeDir }}/.config/aerospace/scripts/force-tile-window.sh code',
    ] },
    { if.app-id = 'ai.opencode.desktop', run = 'move-node-to-workspace code' },
    { if.app-id = 'com.electron.goose', run = 'move-node-to-workspace code' },
    { if.app-id = 'com.anthropic.claudefordesktop', run = 'move-node-to-workspace code' },
    { if.app-id = 'xyz.block.buzz.app', run = 'move-node-to-workspace code' },
    { if.app-id = 'com.aionui.app', run = 'move-node-to-workspace code' },

    # ========== WORKSPACE: term (3) ==========
    { if.app-id = 'com.apple.Terminal', run = 'move-node-to-workspace term' },
    { if.app-id = 'com.mollysoft.MuffinTerm', run = 'move-node-to-workspace term' },

    # ========== WORKSPACE: comms (4) ==========
    # Mail is the primary tiled app on `comms` (full width).
    # Chat / call apps are floated: their own multi-column UIs fight Mail when
    # both are h_tiles side-by-side (see haumea docs). Still moved to `comms`
    # so ⌥⌘4 focuses that workspace; float keeps them usable overlays.
    { if.app-id = 'com.apple.mail', run = 'move-node-to-workspace comms' },
    { if.app-id = 'com.apple.MobileSMS', run = [
        'layout floating',
        'move-node-to-workspace comms',
    ] },
    { if.app-id = 'com.apple.FaceTime', run = [
        'layout floating',
        'move-node-to-workspace comms',
    ] },
    { if.app-id = 'com.apple.mobilephone', run = [
