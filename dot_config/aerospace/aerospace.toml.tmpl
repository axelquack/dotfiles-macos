# ~/.config/aerospace/aerospace.toml
# AeroSpace tiling WM — haumea (audited against installed apps 2026-07-29)
# App version: 0.21.3-Beta · config-version = 2
#
# Workspaces (Alt+Cmd+N):
#   1 web · 2 code · 3 term · 4 comms · 5 docs
#   6 media · 7 files · 8 games · 9 design · 0 vm
#
# Verify IDs: mdls -name kMDItemCFBundleIdentifier -r /Applications/App.app
# Reload: alt-shift-r  or  aerospace reload-config

config-version = 2

start-at-login = true

# Named workspaces stay alive when empty (config-version = 2)
persistent-workspaces = [
    'web', 'code', 'term', 'comms', 'docs',
    'media', 'files', 'games', 'design', 'vm',
]

enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

default-root-container-layout = 'tiles'
default-root-container-orientation = 'auto'
accordion-padding = 30

on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

# -----------------------------------------------------------------------------
# on-window-detected — float first (utilities), then workspace assignment
# Rules only cover apps installed on this machine (audited 2026-07-29).
# -----------------------------------------------------------------------------
on-window-detected = [
    # ========== FLOAT: utilities, trays, control panels, dialogs ==========
    # System
    { if.app-id = 'com.apple.finder', run = 'layout floating' },
    { if.app-id = 'com.apple.systempreferences', run = 'layout floating' },
    { if.app-id = 'com.apple.SystemPreferences', run = 'layout floating' },
    { if.app-id = 'com.apple.AppStore', run = 'layout floating' },
    { if.app-id = 'com.apple.ActivityMonitor', run = 'layout floating' },
    { if.app-id = 'com.apple.Preview', run = 'layout floating' },
    { if.app-id = 'com.apple.calculator', run = 'layout floating' },
    { if.app-id = 'com.apple.Stickies', run = 'layout floating' },
    { if.app-id = 'com.apple.Dictionary', run = 'layout floating' },
    { if.app-id = 'com.apple.FontBook', run = 'layout floating' },
