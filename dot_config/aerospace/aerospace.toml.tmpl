    { if.app-id = 'com.apple.printcenter', run = 'layout floating' },
    { if.app-id = 'com.apple.Magnifier', run = 'layout floating' },
    { if.app-id = 'com.apple.grapher', run = 'layout floating' },
    { if.app-id = 'com.apple.Passwords', run = 'layout floating' },
