# Copy to ~/.config/topgrade.env (gitignored, mode 600) if you want flags.
# Do NOT put an Apple ID password here — mas cannot sign in from the CLI.
#
# Over SSH, scripts/topgrade-wrap.sh already skips the Mac App Store step.
# TOPGRADE_SKIP_MAS=1    # skip MAS even in a GUI Terminal
# TOPGRADE_SKIP_MAS=0    # do not auto-skip on SSH (password prompt)
